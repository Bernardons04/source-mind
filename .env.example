# ==========================================
# ManualMind Configuration
# ==========================================

# Direct PostgreSQL connection with pgvector extension enabled
# (Direct Supabase DB connection, NOT PostgREST or Supabase Data API)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Direct connection or Session Mode (port 5432) for workers and PostgreSQL advisory locks
# Bypasses transaction poolers (such as PgBouncer on port 6543)
DIRECT_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# RabbitMQ broker connection URL for Dramatiq worker and outbox dispatcher
# Must match RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS defined below
RABBITMQ_URL=amqp://YOUR_RABBITMQ_USER:YOUR_RABBITMQ_PASS@localhost:5672/

# RabbitMQ credentials — used by Docker Compose to bootstrap the broker
# These values must be consistent with the user/password in RABBITMQ_URL above
RABBITMQ_DEFAULT_USER=YOUR_RABBITMQ_USER
RABBITMQ_DEFAULT_PASS=YOUR_RABBITMQ_PASS

# Supabase Auth & Storage configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase publishable key for client requests (optional on backend; falls back to SUPABASE_SECRET_KEY)
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase secret key — EXCLUSIVELY for backend/worker storage operations (never expose to frontend!)
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Token verification is performed automatically via Supabase's public JWKS endpoint:
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# (SUPABASE_JWT_SECRET is NOT required for modern asymmetric RS256/ES256 Supabase tokens)
# SUPABASE_JWT_SECRET=optional_legacy_only_if_using_symmetric_hs256

# Storage bucket name in Supabase Storage for private documents (e.g. 'documents')
SUPABASE_STORAGE_BUCKET=documents

# Symmetric encryption key for securing OpenRouter API keys at rest (Fernet URL-safe base64 32-byte key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY

# Backend server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Optional Outbox Dispatcher configuration (defaults shown)
# OUTBOX_POLL_INTERVAL_SECONDS=2.0
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_RETRIES=5

# Optional Reconciliation service configuration (defaults shown)
# RECONCILIATION_INTERVAL_SECONDS=1800.0   # Run cycle every 30 minutes
# RECONCILIATION_OLDER_THAN_HOURS=2        # Reconcile uploads stuck in 'uploading' for > 2 hours

# Frontend public variables (client-safe keys only — never expose SUPABASE_SECRET_KEY to the browser!)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Modern public key naming (legacy name: NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY  # Supported as fallback
NEXT_PUBLIC_API_URL=http://localhost:8000/api
