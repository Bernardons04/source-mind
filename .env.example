# ==========================================
# ManualMind Configuration
# ==========================================

# Direct PostgreSQL connection with pgvector extension enabled
# (Direct Supabase DB connection, NOT PostgREST or Supabase Data API)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth & Storage configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Used by FastAPI to cryptographically verify user JWT tokens
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# Storage bucket name in Supabase Storage for private documents (e.g. 'documents')
SUPABASE_STORAGE_BUCKET=documents

# Symmetric encryption key for securing OpenRouter API keys at rest (Fernet URL-safe base64 32-byte key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY

# Backend server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend public variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_API_URL=http://localhost:8000/api
